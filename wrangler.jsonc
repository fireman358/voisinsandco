{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "voisinsandco",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "voisins-and-co-db",
      // UUID de la base créée avec : npx wrangler d1 create voisins-and-co-db
      "database_id": "2b4adc41-6e46-4e99-9887-5d663b79e211",
      "migrations_dir": "migrations"
    }
  ]
}
